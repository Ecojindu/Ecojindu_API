# ─────────────────────────────────────────────────────────────
#  Ecojindu Shuttle — Integrations & Agent Gateway (.env)
#  Everything the outside world talks to: WhatsApp, Paystack
#  webhooks, and the REST surface the AI agent consumes.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
DEBUG=true
APP_NAME="Ecojindu Shuttle API Gateway"
PORT=8001
LOG_LEVEL=INFO
LOG_JSON=false

# ── Core backend (service-to-service) ────────────────────────
# Must match ecojindu-backend's SERVICE_API_KEY exactly.
BACKEND_BASE_URL=http://localhost:8000
SERVICE_API_KEY=dev-service-key-change-me
BACKEND_TIMEOUT_SECONDS=25

# ── Shared database ──────────────────────────────────────────
# Same `ecojindu` database as the backend. This service only reads/writes
# `whatsapp_sessions`; the backend owns the schema and its migrations.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecojindu

# ── AI-agent API keys ────────────────────────────────────────
# Comma-separated so you can issue one key per consumer and rotate
# them independently. Sent as `X-API-Key` on every /agent/v1 request.
AGENT_API_KEYS=dev-agent-key-change-me
AGENT_RATE_LIMIT_PER_MINUTE=120

# ── Twilio WhatsApp ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sandbox number; swap for your approved WhatsApp sender in production.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_STATUS_CALLBACK_URL=http://localhost:8001/webhooks/twilio/status
# Reject inbound webhooks whose X-Twilio-Signature doesn't verify (turn on in production).
TWILIO_VALIDATE_SIGNATURE=false
# Leave true to log outbound WhatsApp messages instead of sending them.
TWILIO_MOCK=true
PUBLIC_BASE_URL=http://localhost:8001

# ── Paystack (webhook signature verification only) ───────────
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Skip signature checks locally; always false in production.
PAYSTACK_MOCK=true

# ── WhatsApp conversation ────────────────────────────────────
WHATSAPP_SESSION_TIMEOUT_MINUTES=30
WHATSAPP_MAX_SEATS=6

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Branding (used in WhatsApp copy) ─────────────────────────
COMPANY_NAME="Ecojindu Shuttle"
COMPANY_EMAIL=jinduinc@gmail.com
COMPANY_PHONE=+2348154471570
WEB_BASE_URL=http://localhost:3000
